# ---------------------------------------------------------------------------
# AskBack AI Student — 環境變數範例（複製成 .env 後填入，切勿把金鑰提交到 Git）
# 所有金鑰只能從環境變數讀取，程式不會把金鑰寫入原始碼、JSON、日誌或 manifest。
# ---------------------------------------------------------------------------

# ---- TTS 供應商 ----
# auto | edge | openai | azure | sapi
# auto  = 依序嘗試已設定金鑰的雲端供應商，再退回本機 Windows SAPI(zh-TW)
# sapi  = 本機語音引擎（Windows System.Speech，需安裝 zh-TW 語音，不需金鑰）
ASKBACK_TTS_PROVIDER=auto

# 各供應商的聲音設定（可留空用預設）
# edge-tts（免費，需網路，不需金鑰）
ASKBACK_TTS_VOICE=zh-TW-XiaoXiaoNeural
# 本機 SAPI 語音名稱（留空則自動挑選 zh-TW 語音，例如 Microsoft Hanhan Desktop）
ASKBACK_TTS_SAPI_VOICE=
# 語速：-10 ~ 10（SAPI）；edge/openai 以百分比表示於下方
ASKBACK_TTS_RATE=2

# OpenAI TTS（需金鑰）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ASKBACK_TTS_OPENAI_MODEL=tts-1
ASKBACK_TTS_OPENAI_VOICE=shimmer

# Azure Speech TTS（需金鑰與區域）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
ASKBACK_TTS_AZURE_VOICE=zh-TW-HsiaoChenNeural

# ---- 可選：學生迷思文本生成使用 LLM（留空則使用內建迷思資料庫） ----
# askbac | none
ASKBACK_LLM_PROVIDER=none
ASKBACK_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY 亦供 LLM 使用（同上，不寫入任何檔案）

# ---- 動畫 / 影片輸出 ----
ASKBACK_VIDEO_WIDTH=1280
ASKBACK_VIDEO_HEIGHT=720
ASKBACK_VIDEO_FPS=24
# 目標影片長度（秒），規格要求 30–90
ASKBACK_TARGET_MIN=30
ASKBACK_TARGET_MAX=90
