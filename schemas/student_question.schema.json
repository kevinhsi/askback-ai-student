{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://askback-ai.local/schemas/student_question.schema.json",
  "title": "AskBack AI Student — student_question.json",
  "description": "AI 學生迷思與提問資料（本階段僅呈現學生迷思，不含教學設計與標準解答）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "generator",
    "unit",
    "student",
    "misconception",
    "question",
    "interaction",
    "safety",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\." },
    "generated_at": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["template", "llm"] },
        "model": { "type": ["string", "null"] },
        "fallback_reason": { "type": ["string", "null"] }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "subject", "grade", "semester", "unit_id", "unit_name", "topics"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "grade": { "type": "string", "minLength": 1 },
        "semester": { "type": "string", "minLength": 1 },
        "unit_id": { "type": "string", "minLength": 1 },
        "unit_name": { "type": "string", "minLength": 1 },
        "unit_code": { "type": ["string", "null"] },
        "topics": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "grade", "age", "region", "language", "character", "voice"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "grade": { "type": "string" },
        "age": { "type": "integer", "minimum": 10, "maximum": 13 },
        "region": { "type": "string" },
        "language": { "const": "zh-TW" },
        "character": {
          "type": "object",
          "additionalProperties": false,
          "required": ["persona", "speech_style", "vocabulary_notes", "avoid"],
          "properties": {
            "persona": { "type": "string", "minLength": 1 },
            "speech_style": { "type": "string", "minLength": 1 },
            "vocabulary_notes": { "type": "string" },
            "avoid": { "type": "array", "items": { "type": "string" } }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locale", "style", "synthetic"],
          "properties": {
            "locale": { "const": "zh-TW" },
            "style": { "type": "string" },
            "synthetic": { "const": true },
            "note": { "type": "string" }
          }
        }
      }
    },
    "misconception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sticking_point",
        "statement",
        "display_problem",
        "faulty_reasoning",
        "why_it_feels_right",
        "forbidden_answer_terms"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "sticking_point": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "display_problem": { "type": "string", "minLength": 1 },
        "faulty_reasoning": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "thought"],
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "thought": { "type": "string", "minLength": 1 }
            }
          }
        },
        "why_it_feels_right": { "type": "string", "minLength": 1 },
        "forbidden_answer_terms": { "type": "array", "items": { "type": "string" } },
        "unit_id": { "type": "string" },
        "line_hints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scene", "expression"],
            "properties": {
              "scene": {
                "type": "string",
                "enum": ["intro", "problem", "reasoning", "doubt", "recall", "puzzle", "ask"]
              },
              "expression": {
                "type": "string",
                "enum": ["neutral", "curious", "think", "confident", "confused", "worried", "puzzled", "hopeful"]
              }
            }
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_text", "lines", "tone", "topics", "language"],
      "properties": {
        "original_text": { "type": "string", "minLength": 10 },
        "lines": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 2 }
        },
        "tone": { "type": "string", "minLength": 1 },
        "topics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "language": { "const": "zh-TW" }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "turns"],
      "properties": {
        "mode": { "type": "string", "enum": ["single", "multi"] },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn", "role", "text"],
            "properties": {
              "turn": { "type": "integer", "minimum": 1 },
              "role": { "type": "string", "enum": ["student", "user"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_leak", "scope"],
      "properties": {
        "answer_leak": {
          "type": "object",
          "additionalProperties": false,
          "required": ["leaked", "checked_terms", "notes"],
          "properties": {
            "leaked": { "type": "boolean" },
            "checked_terms": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          }
        },
        "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_generated_student", "disclaimer", "purpose"],
      "properties": {
        "ai_generated_student": { "const": true },
        "disclaimer": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      }
    }
  }
}
